# 복사해서 .env로 쓴다. 값은 커밋하지 않는다.
# 포트(CLIENT_PORT, SERVER_PORT, POSTGRES_PORT, REDIS_PORT)는 여기에 두지 않는다.
# Superset 워크스페이스에서는 .superset/workspace.env가, 그 밖에서는 코드의 기본값
# (5173, 3000, 5432, 6379)이 쓰인다.

POSTGRES_USER=nlmlio
POSTGRES_PASSWORD=nlmlio
POSTGRES_DB=nlmlio

# 운영처럼 접속 정보를 통째로 줄 때만 쓴다. 비워 두면 위 값과 포트로 만든다.
# DATABASE_URL=
# REDIS_URL=

# 서로 다른 무작위 값으로 설정한다(각 32자 이상). 실제 값을 커밋하지 않는다.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
