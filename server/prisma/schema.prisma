// DB 스키마의 유일한 원본. 바꾸면 `pnpm db:migrate --name <설명>`으로 마이그레이션을 만든다.
// 모델(User, Game, GameResult, PointHistory …)은 기능을 구현하면서 추가한다.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int          @id @default(autoincrement())
  username       String       @unique @db.VarChar(20)
  nickname       String       @unique @db.VarChar(10)
  email          String       @unique @db.VarChar(254)
  passwordHash   String
  authVersion    Int          @default(0)
  point          Int          @default(0)
  pointReachedAt DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  results        GameResult[]

  @@index([point(sort: Desc), pointReachedAt, createdAt, id])
}

model Game {
  id          String       @id
  roomCode    String       @db.VarChar(6)
  roomName    String       @db.VarChar(80)
  playerCount Int
  startedAt   DateTime
  endedAt     DateTime
  results     GameResult[]
}

model GameResult {
  id            Int      @id @default(autoincrement())
  gameId        String
  userId        Int
  rank          Int
  pointDelta    Int
  bellSuccess   Int      @default(0)
  bellFail      Int      @default(0)
  reactionSumMs Int      @default(0)
  departed      Boolean  @default(false)
  playedAt      DateTime
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([gameId, userId])
  @@unique([gameId, rank])
  @@index([userId, playedAt(sort: Desc), id(sort: Desc)])
}
